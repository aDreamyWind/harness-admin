APP_NAME=Harness Admin
APP_ENV=development
HTTP_ADDR=:8080
DATABASE_URL=postgres://harness:harness@localhost:55432/harness_admin?sslmode=disable
REDIS_ADDR=localhost:56379
REDIS_PASSWORD=
REDIS_DB=0
AUTO_MIGRATE=true
SHUTDOWN_TIMEOUT=10s
SESSION_TTL=12h
SESSION_COOKIE_NAME=harness_admin_session

# 仅用于执行 make bootstrap-admin，命令结束后可从本地 .env 删除。
BOOTSTRAP_ORG_CODE=default
BOOTSTRAP_ORG_NAME=默认企业
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_DISPLAY_NAME=系统管理员
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
