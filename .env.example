APP_NAME=Harness Admin
APP_ENV=development
HTTP_ADDR=:8080
DATABASE_URL=postgres://harness:harness@localhost:55432/harness_admin?sslmode=disable
REDIS_ADDR=localhost:56379
REDIS_PASSWORD=
REDIS_DB=0
AUTO_MIGRATE=true
SHUTDOWN_TIMEOUT=10s
# 漫剧生成图片的持久化目录，部署时需挂载并与数据库一起备份。
DRAMA_MEDIA_DIRECTORY=./data/drama-media
SESSION_TTL=12h
SESSION_COOKIE_NAME=harness_admin_session
PLATFORM_SESSION_COOKIE_NAME=harness_platform_session

# OIDC 对外签发者地址。生产环境必须使用外部系统可访问的 HTTPS 地址。
OIDC_ISSUER=http://localhost:8080
# 管理端登录页地址；本地 Vite 默认为 5173，生产环境填写实际 HTTPS 控制台地址。
CONSOLE_URL=http://localhost:5173
# PEM 格式 RSA 私钥；适合由部署平台直接注入，与下方文件配置二选一。
OIDC_SIGNING_PRIVATE_KEY=
# RSA 私钥文件路径；本地开发建议使用 .secrets/oidc-signing-private-key.pem，生产环境建议挂载密钥文件。
OIDC_SIGNING_PRIVATE_KEY_FILE=

# Base64 编码的 32 字节密钥。示例值仅用于本地开发，生产环境必须替换。
MODEL_CREDENTIAL_MASTER_KEY=aGFybmVzcy1hZG1pbi1kZXYtbW9kZWwta2V5LTAwMDE=
# 允许访问私有或 HTTP 模型服务的精确主机名，多个值使用逗号分隔。
MODEL_PROVIDER_PRIVATE_HOSTS=localhost
# 允许访问私有或 HTTP MCP 服务的精确主机名；与模型供应商白名单分开配置。
MCP_PRIVATE_HOSTS=localhost

# 仅在 Docker 守护进程已隔离、管理员信任代码来源时开启源码 MCP 托管；默认关闭。
MCP_DEPLOY_ENABLED=false
# 生产环境必须填写固定到 @sha256:... 的基础镜像；下面的标签仅供本地开发。
MCP_NODE_IMAGE=node:22-alpine
MCP_PYTHON_IMAGE=python:3.12-slim
# 构建阶段默认断网；依赖未随包提供时可在受控构建环境中设为 bridge。运行阶段始终断网。
MCP_BUILD_NETWORK=none

# 仅用于执行 make bootstrap-admin，命令结束后可从本地 .env 删除。
BOOTSTRAP_ORG_CODE=default
BOOTSTRAP_ORG_NAME=默认企业
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_DISPLAY_NAME=企业管理员
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# 仅用于执行 make bootstrap-platform-admin，平台账号与企业账号相互隔离。
BOOTSTRAP_PLATFORM_ADMIN_USERNAME=platform-admin
BOOTSTRAP_PLATFORM_ADMIN_DISPLAY_NAME=平台管理员
BOOTSTRAP_PLATFORM_ADMIN_PASSWORD=

# 仅用于执行 make seed-test-organization，默认复用初始化企业和管理员。
TEST_ORG_CODE=default
TEST_ORG_ACTOR_USERNAME=admin
